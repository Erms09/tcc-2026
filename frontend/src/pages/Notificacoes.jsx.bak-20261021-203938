
import React, { useMemo, useState } from "react";
import { Link } from "react-router-dom";

export default function Notificacoes({
  notifications = [],
  onMarkRead,
  onMarkAllRead,
  onDelete,
  onClearAll,
}) {
  const [filter, setFilter] = useState("todas");

  const unreadCount = notifications.filter(
    (notification) => !notification.read
  ).length;

  const visibleNotifications = useMemo(() => {
    if (filter === "nao-lidas") {
      return notifications.filter((notification) => !notification.read);
    }

    if (filter === "lidas") {
      return notifications.filter((notification) => notification.read);
    }

    return notifications;
  }, [notifications, filter]);

  function formatDate(value) {
    if (!value) return "Agora";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) return "Data indisponível";

    return date.toLocaleString("pt-BR", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function getIcon(type) {
    const icons = {
      welcome: "👋",
      favorite: "❤️",
      comment: "💬",
      game: "🎮",
      achievement: "🏆",
      system: "🔔",
    };

    return icons[type] || icons.system;
  }

  return (
    <main className="container simple-page notifications-page">
      <div className="notifications-heading">
        <div>
          <span className="eyebrow">FIQUE POR DENTRO</span>
          <h1>Notificações</h1>
          <p>
            Acompanhe suas atividades e novidades no IndieHub.
          </p>
        </div>

        <div className="notifications-counter">
          <strong>{unreadCount}</strong>
          <span>não lida(s)</span>
        </div>
      </div>

      <div className="notifications-toolbar">
        <div className="notifications-filters">
          <button
            type="button"
            className={filter === "todas" ? "active" : ""}
            onClick={() => setFilter("todas")}
          >
            Todas ({notifications.length})
          </button>

          <button
            type="button"
            className={filter === "nao-lidas" ? "active" : ""}
            onClick={() => setFilter("nao-lidas")}
          >
            Não lidas ({unreadCount})
          </button>

          <button
            type="button"
            className={filter === "lidas" ? "active" : ""}
            onClick={() => setFilter("lidas")}
          >
            Lidas ({notifications.length - unreadCount})
          </button>
        </div>

        <div className="notifications-actions">
          <button
            type="button"
            className="notifications-text-button"
            onClick={onMarkAllRead}
            disabled={unreadCount === 0}
          >
            Marcar todas como lidas
          </button>

          {notifications.length > 0 && (
            <button
              type="button"
              className="notifications-text-button notifications-delete-all"
              onClick={() => {
                if (window.confirm("Deseja excluir todas as notificações?")) {
                  onClearAll();
                }
              }}
            >
              Limpar tudo
            </button>
          )}
        </div>
      </div>

      <section className="notifications-list" aria-label="Lista de notificações">
        {visibleNotifications.length === 0 ? (
          <div className="notifications-empty">
            <span>🔔</span>
            <h2>
              {filter === "nao-lidas"
                ? "Tudo em dia!"
                : filter === "lidas"
                  ? "Nenhuma notificação lida"
                  : "Nenhuma notificação ainda"}
            </h2>
            <p>
              {filter === "nao-lidas"
                ? "Você não tem notificações pendentes."
                : "Suas notificações aparecerão aqui conforme você usar o IndieHub."}
            </p>

            <Link to="/catalogo" className="primary-button">
              Explorar jogos
            </Link>
          </div>
        ) : (
          visibleNotifications.map((notification) => (
            <article
              className={`notification-card ${
                notification.read ? "is-read" : "is-unread"
              }`}
              key={notification.id}
            >
              <div className="notification-icon">
                {getIcon(notification.type)}
              </div>

              <div className="notification-content">
                <div className="notification-title-row">
                  <h2>{notification.title}</h2>
                  {!notification.read && (
                    <span className="notification-unread-dot" title="Não lida" />
                  )}
                </div>

                <p>{notification.message}</p>

                <time dateTime={notification.createdAt}>
                  {formatDate(notification.createdAt)}
                </time>

                {notification.gameId && (
                  <Link
                    className="notification-game-link"
                    to={`/jogo/${notification.gameId}`}
                    onClick={() => onMarkRead(notification.id)}
                  >
                    Ver jogo →
                  </Link>
                )}
              </div>

              <div className="notification-card-actions">
                {!notification.read && (
                  <button
                    type="button"
                    onClick={() => onMarkRead(notification.id)}
                    aria-label={`Marcar "${notification.title}" como lida`}
                    title="Marcar como lida"
                  >
                    ✓
                  </button>
                )}

                <button
                  type="button"
                  onClick={() => onDelete(notification.id)}
                  aria-label={`Excluir "${notification.title}"`}
                  title="Excluir notificação"
                >
                  ×
                </button>
              </div>
            </article>
          ))
        )}
      </section>
    </main>
  );
}
